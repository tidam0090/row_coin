DATABASE_URL=postgres://coinrow:changeMe123!@localhost:5432/coinrow
PORT=4000
# ⚠️ IMPORTANT: Set to a strong random string (min 32 characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_KEY=change-this-to-a-long-random-secret
# ⚠️ IMPORTANT: Set to a strong random string (min 32 characters)  
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-this-too-to-a-long-random-secret
# Comma-separated list of allowed origins (no wildcards in production!)
# Example: https://yourdomain.com,https://www.yourdomain.com
CORS_ORIGIN=http://localhost:5173

# Frontend URL used for password reset links
FRONTEND_URL=http://localhost:5173

# Email configuration (Gmail SMTP)
# For Gmail, use an App Password if 2FA is enabled: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
FROM_EMAIL=your-email@gmail.com
FROM_NAME=Coin Row
